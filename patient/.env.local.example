# WithMIKI 患者用デイリーレコード（PWA）環境変数テンプレート
# このファイルをコピーして .env.local を作成。.env.local はコミットしないこと。
# 取得元: docs/setup/supabase-setup.md §6

# ===== Supabase（ブラウザにも露出する公開値）=====
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key

# ===== AI（食事写真OCR：サーバー専用。任意）=====
ANTHROPIC_API_KEY=sk-ant-...your-key
ANTHROPIC_MODEL=claude-sonnet-4-6

# ===== LINE LIFF ログイン（任意・LINEチャネル設定が必要）=====
NEXT_PUBLIC_LIFF_ID=xxxxxxxxxx-xxxxxxxx
LINE_LOGIN_CHANNEL_ID=1234567890
