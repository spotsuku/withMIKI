# WithMIKI 環境変数サンプル
# 実際の値は .env に記載し、絶対にコミットしないこと（docs/05-security-compliance.md）。
# 利用するのは Phase 1 以降。設計フェーズでは参照のみ。

# ===== データベース =====
DATABASE_URL=postgresql://user:password@localhost:5432/withmiki

# ===== 認証 / JWT =====
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ===== Claude API（サーバー側のみ。クライアントに渡さない） =====
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# ===== LINE Messaging API / LIFF =====
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LIFF_ID=

# ===== オブジェクトストレージ（S3 互換） =====
STORAGE_ENDPOINT=
STORAGE_BUCKET=withmiki-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=ap-northeast-1

# ===== アプリ =====
APP_ENV=local
API_BASE_URL=http://localhost:3000/v1
