# WithMIKI 先生用カルテ Web - 環境変数テンプレート
# このファイルをコピーして .env.local を作成し、値を設定してください。
# .env.local はコミットしないこと（.gitignore 済み / docs/05-security-compliance.md）。
# 取得元は docs/setup/supabase-setup.md §6 を参照。

# ===== Supabase（ブラウザにも露出する公開値）=====
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key

# ===== サーバー専用（絶対にクライアントへ出さない）=====
# 管理操作・インポータ --commit 等で使用。Vercel では「Production/Preview」にのみ設定し、
# NEXT_PUBLIC_ を付けないこと（付けるとバンドルに含まれ漏洩する）。
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key

# ===== AI（Claude API：サーバー専用。クライアントに出さない）=====
# 採血OCR・食事解析・カルテ補助のサーバープロキシで使用（/api/ai/*）。
ANTHROPIC_API_KEY=sk-ant-...your-key
ANTHROPIC_MODEL=claude-sonnet-4-6

# ===== 開発用ログインスキップ（本番では設定しないこと）=====
# NEXT_PUBLIC_DEV_LOGIN=1 でログイン画面に「開発用ログイン」ボタンを表示。
# ボタンは下記の固定アカウントに自動ログインする（サーバー側 env が無いと無効）。
# 本番(Vercel Production)では3つとも未設定にする = ボタンが出ても機能しない。
NEXT_PUBLIC_DEV_LOGIN=1
DEV_LOGIN_EMAIL=hiroaki_miki@office-miki.jp
DEV_LOGIN_PASSWORD=（Authで設定したパスワード）


# ===== Google Calendar 連携（任意・サーバー専用）=====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<your-domain>/api/google/callback

# ===== メール送信（予約確定メール：任意）=====
RESEND_API_KEY=
RESEND_FROM=WithMIKI <noreply@your-domain>
