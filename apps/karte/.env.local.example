# WithMIKI 先生用カルテ Web - 環境変数テンプレート
# このファイルをコピーして .env.local を作成し、値を設定してください。
# .env.local はコミットしないこと（.gitignore 済み / docs/05-security-compliance.md）。
# 取得元は docs/setup/supabase-setup.md §6 を参照。

# ===== Supabase（ブラウザにも露出する公開値）=====
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key

# ===== サーバー専用（絶対にクライアントへ出さない）=====
# 管理操作・インポータ --commit 等で使用。Vercel では「Production/Preview」にのみ設定し、
# NEXT_PUBLIC_ を付けないこと（付けるとバンドルに含まれ漏洩する）。
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key
